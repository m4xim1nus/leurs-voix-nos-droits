// Worker de l'admin (docs/CONCEPTION.md, Admin). Mise en service : admin/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lvnd-admin",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // Aucune adresse *.workers.dev ni de prévisualisation : l'admin n'est servie que derrière Access.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lvnd-admin",
      // `npx wrangler d1 create lvnd-admin`, puis reporter ici l'identifiant obtenu.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_REPO": "m4xim1nus/leurs-voix-nos-droits",
    "GITHUB_BRANCH": "main",
    "EDITORIAL_CHEMIN": "data/editorial.json",
    // Application Access : domaine d'équipe (https://<équipe>.cloudflareaccess.com) et audience (AUD).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
  // Secret (jamais ici) : `npx wrangler secret put GITHUB_TOKEN`.
}
