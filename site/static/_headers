# En-têtes servis par Cloudflare Pages.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# SvelteKit hache ces noms de fichiers : cache immuable.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Données et index de recherche : un nouveau build peut les réécrire sous le même nom.
/donnees/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/recherche/*
  Cache-Control: public, max-age=3600
